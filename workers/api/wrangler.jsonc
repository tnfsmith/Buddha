{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "vandao",
  // Production (tài khoản a5f038f5…, chỉ deploy khi gắn tag vX.Y.Z). Một Worker phục vụ cả API lẫn trang tĩnh apps/web/public.
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "../../apps/web/public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/media/*", "/ws/*", "/.well-known/*"]
  },
  "routes": [
    { "pattern": "vandao.ainextbrain.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vandao-core",
      "database_id": "9930849b-af4f-46b7-b7f1-c58cade859d5",
      "migrations_dir": "../../db/migrations"
    }
  ],
  "kv_namespaces": [
    { "binding": "CONFIG", "id": "561aec70f7ee4098a30d054ad224cdbb" }
  ],
  "r2_buckets": [
    { "binding": "MEDIA", "bucket_name": "vandao-media" }
  ],
  // Giới hạn tần suất (§5): RL_AUTH đăng nhập 5/phút/IP · RL_POLL hỏi QR, số liệu 60/phút/IP · RL_OTP 3/phút/IP
  // · RL_SYNC 30/phút/người · RL_API 60/phút/người · RL_TICKET 20/phút/người
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_POLL", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_OTP", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
    { "name": "RL_SYNC", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_API", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
    { "name": "RL_TICKET", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } }
  ],
  // T1.3 (#8): số liệu ẩn danh (FPS theo nhóm máy, lỗi JS) — Analytics Engine, gói Free 100.000 điểm/ngày
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "vd_metrics" }],
  "vars": { "ENV_NAME": "production", "REMINDERS_ENABLED": "0" },
  // Dọn dữ liệu hằng đêm 02:17 giờ Việt Nam (src/cron.js)
  "triggers": { "crons": ["17 19 * * *"] },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "name": "vandao-staging",
      "workers_dev": true,
      "preview_urls": true,
      "routes": [],
      "assets": {
        "directory": "../../apps/web/public",
        "binding": "ASSETS",
        "html_handling": "auto-trailing-slash",
        "not_found_handling": "single-page-application",
        "run_worker_first": ["/api/*", "/media/*", "/ws/*", "/.well-known/*"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "vandao-core-staging",
          "database_id": "a9c4ecd2-2084-4aa8-9a63-a2e716d06044",
          "migrations_dir": "../../db/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CONFIG",
          "id": "52f5a88f999344b5a04ec7aa1ae84325"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "vandao-media-staging"
        }
      ],
      "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "vd_metrics_staging" }],
      "ratelimits": [
        { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_POLL", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_OTP", "namespace_id": "1003", "simple": { "limit": 3, "period": 60 } },
        { "name": "RL_SYNC", "namespace_id": "1004", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_API", "namespace_id": "1005", "simple": { "limit": 60, "period": 60 } },
        { "name": "RL_TICKET", "namespace_id": "1006", "simple": { "limit": 20, "period": 60 } }
      ],
      "triggers": { "crons": ["17 19 * * *"] },
      "vars": { "ENV_NAME": "staging", "REMINDERS_ENABLED": "0" }
    }
  }
}
